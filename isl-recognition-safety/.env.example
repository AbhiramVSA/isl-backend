# Copy to .env (all values optional; defaults are in backend/app/config.py)

# Compute: auto | cuda | cpu
ISL_DEVICE=auto
ISL_HWGAT_FP16=true

# Language layer: none | anthropic | ollama
ISL_LLM_PROVIDER=none
ISL_ANTHROPIC_MODEL=claude-opus-5
# The Anthropic SDK reads the key from the environment (or an `ant auth login` profile):
# ANTHROPIC_API_KEY=sk-ant-...
ISL_OLLAMA_MODEL=qwen2.5:3b
ISL_OLLAMA_URL=http://localhost:11434

# Recognition thresholds
ISL_CONF_HIGH=0.55
ISL_CONF_LOW=0.35
ISL_MARGIN_MIN=0.15
ISL_WINDOW_STRIDE_MS=400
ISL_WINDOW_STRIDE_CPU_MS=1200
ISL_SENTENCE_REST_MS=1200

# Safety
ISL_IMMOBILE_WARN_S=10
ISL_LONG_LIE_S=60
ISL_EVENT_COOLDOWN_S=30

# Uploads / CORS
ISL_MAX_UPLOAD_MB=200
ISL_CORS_ORIGINS=*
