SECRET_KEY=change-me-to-a-long-random-value
DATABASE_URL=sqlite+aiosqlite:///./incident.db
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=26214400
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret


# --- Equal app (mounted at /app) ---------------------------------------------
# The app holds one token and has no refresh flow, so its token outlives the
# console's 15-minute one rather than signing someone out mid-emergency.
MOBILE_ACCESS_TOKEN_DAYS=30
# Set to hold the NIM key server-side; unset, /app/api/v1/llm/chat answers 503
# and the app keeps calling NVIDIA directly with the key inside its binary.
NVIDIA_NIM_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_DEFAULT_MODEL=meta/muse-glimmer-30b
