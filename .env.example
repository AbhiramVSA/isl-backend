# Copy to .env and adjust. All values have working defaults (see app/core/config.py).

# DATABASE_URL=sqlite:///./app.db
# NeonDB example:
# DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# LSTM_WEIGHTS_PATH=ml_models/170-0.83.hdf5

# Browser origins allowed to call the API (comma-separated). Default "*".
# CORS_ORIGINS=https://isl.example.org

# Docker only: host port docker-compose publishes the API on (default 8100).
# ISL_PORT=8100
