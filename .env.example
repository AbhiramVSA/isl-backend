# Copy to .env and adjust. All values have working defaults (see app/core/config.py).

# DATABASE_URL=sqlite:///./app.db
# NeonDB example:
# DATABASE_URL=postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# LSTM_WEIGHTS_PATH=ml_models/170-0.83.hdf5

# --- auth -------------------------------------------------------------------
# MUST be set to a random value in production. With the default, anyone who has
# read the source can mint a token for any account.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=
# ACCESS_TOKEN_TTL_MINUTES=43200

# --- NVIDIA NIM proxy -------------------------------------------------------
# Set this to move the key off the mobile clients, where it can be extracted
# from the shipped binary. Without it, /api/v1/llm/chat returns 503 and the app
# keeps calling NIM directly.
# NVIDIA_NIM_API_KEY=nvapi-xxxxxxxxxxxxxxxx
# NIM_DEFAULT_MODEL=z-ai/glm-5.2

# --- station directory ------------------------------------------------------
# Point at the real AP Police directory. The bundled file is placeholder data
# with fake phone numbers.
# STATIONS_FILE=data/police_stations.json
